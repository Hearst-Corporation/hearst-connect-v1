# Hearst Connect — variables d'environnement
# Copier en .env.local (gitignoré) et remplir. Aucune valeur réelle ici.

# Clé de signature des sessions — 32 caractères minimum.
# Génération : openssl rand -hex 32
AUTH_SECRET=

# Compte propriétaire (doctrine Hearst §7). Le mot de passe ne vit jamais
# dans le code : ici en développement, dans le gestionnaire de secrets en production.
ADRIEN_OWNER_EMAIL=adrien@hearstcorporation.io
ADRIEN_OWNER_PASSWORD=
