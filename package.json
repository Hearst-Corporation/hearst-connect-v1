{
  "name": "hearst-connect",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev --port 4105",
    "start": "next start --port 4105",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run check:no-gpu1 && pnpm run check:no-zinc && pnpm run check:mocks && pnpm run check:truthful-data && pnpm run check:ds && pnpm run check:ui && pnpm run check:english-ui && pnpm run test",
    "lint:fast": "oxlint src",
    "quality:dead": "knip",
    "quality:dup": "node scripts/check-duplication.mjs",
    "quality:dup:report": "jscpd src --threshold 100 --reporters consoleFull",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "dashboard:open": "node scripts/open-dashboard-chrome.mjs",
    "sonar": "node scripts/sonar.mjs",
    "check:mocks": "node scripts/check-no-mocks.mjs",
    "check:truthful-data": "node scripts/check-truthful-data.mjs",
    "check:no-gpu1": "node scripts/check-no-gpu1.mjs",
    "check:no-zinc": "node scripts/check-no-zinc.mjs",
    "check:ds": "node scripts/check-design-system.mjs",
    "check:ui": "node scripts/check-ui-boundaries.mjs",
    "check:english-ui": "node scripts/check-english-ui.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.1",
    "motion": "^12.38.0",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.12",
    "jscpd": "^5.0.14",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.12",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
