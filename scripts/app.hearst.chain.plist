<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tâche planifiée de la chaîne Hearst : scripts/chain-cron.sh toutes les heures.
     Installation : cp scripts/app.hearst.chain.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/app.hearst.chain.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>app.hearst.chain</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>/Users/user/hearst-connect-v1/scripts/chain-cron.sh</string></array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/user/Library/Logs/hearst-chain.log</string>
  <key>StandardErrorPath</key><string>/Users/user/Library/Logs/hearst-chain.log</string>
</dict>
</plist>
