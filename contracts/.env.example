# Copier en .env (jamais commité) puis remplir. Aucune clé privée ici :
# les clés vivent dans le keystore chiffré de Foundry (cast wallet import), voir README.

# Nœuds RPC (Alchemy, Infura… ; un compte gratuit suffit pour Sepolia)
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=

# Vérification du code source sur Etherscan (clé API v2, valable pour toutes les chaînes)
ETHERSCAN_API_KEY=

# Déploiement
REGISTRY_ADMIN=
REGISTRY_PUBLISHER=

# Publication mensuelle
REGISTRY_ADDRESS=
ATTESTATION_FILE=attestations/202611.json

# Règles de l'offre, figées au déploiement
FEE_BPS=1500
REFILL_CAP_BPS=5000

# Oracle de l'économie du minage (HearstMiningOracle)
# Flux Chainlink BTC/USD — vide = le cours est publié avec les relevés.
# Sepolia 0x1b44F3514812d835EB1BDB0acB33d3fA3351Ee43 · mainnet 0xF4030086522a5bEEa4988F8cA5B36dbC97BeE88c
BTC_USD_FEED=
POWER_USD_PER_KWH_E6=65000
EFFICIENCY_JTH_E2=1100
HARDWARE_USD_PER_THS_E6=11200000
AMORTIZATION_DAYS=1460
MAX_AGE=86400
MINING_ORACLE_ADDRESS=
