# Copier en .env (jamais commité) puis remplir. Aucune clé privée ici :
# les clés vivent dans le keystore chiffré de Foundry (cast wallet import), voir README.

# Nœuds RPC (Alchemy, Infura… ; un compte gratuit suffit pour Sepolia)
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=

# Vérification du code source sur Etherscan (clé API v2, valable pour toutes les chaînes)
ETHERSCAN_API_KEY=

# Déploiement
REGISTRY_ADMIN=
REGISTRY_PUBLISHER=

# Publication mensuelle
REGISTRY_ADDRESS=
ATTESTATION_FILE=attestations/202609.json
