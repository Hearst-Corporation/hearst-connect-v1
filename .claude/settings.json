{
  "extraKnownMarketplaces": {
    "hearst": {
      "source": {
        "source": "github",
        "repo": "Hearst-Corporation/hearst-claude"
      }
    }
  },
  "hooks": {},
  "enabledPlugins": {
    "hearst-core@hearst": false,
    "hearst-secops@hearst": false,
    "hearst-storybook@hearst": false
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "bypassPermissions"
  }
}
